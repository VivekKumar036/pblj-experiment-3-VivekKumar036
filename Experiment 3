#Calculate interest based on the type of the account and the status of the account holder. The rates of interest changes according to the amount (greater than or less than 1 crore), age of account holder (General or Senior citizen) and number of days if the type of account is FD or RD.

import java.util.Scanner;

public class InterestCalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter account type (FD/RD): ");
        String accountType = sc.next();

        System.out.println("Enter amount (in crores, e.g., 1 for 1 crore): ");
        double amount = sc.nextDouble();

        System.out.println("Enter age category (General/Senior Citizen): ");
        String ageCategory = sc.next();

        System.out.println("Enter number of days: ");
        int days = sc.nextInt();

        double interestRate = 0;
        if (accountType.equalsIgnoreCase("FD")) {
            if (ageCategory.equalsIgnoreCase("Senior Citizen")) {
                if (amount >= 1.0) {
                    if (days >= 7 && days <= 45) interestRate = 6.0;
                    else if (days >= 46 && days <= 90) interestRate = 6.5;
                    else if (days >= 91 && days <= 180) interestRate = 7.0;
                    else if (days > 180) interestRate = 7.5;
                } else {
                    if (days >= 7 && days <= 45) interestRate = 5.5;
                    else if (days >= 46 && days <= 90) interestRate = 6.0;
                    else if (days >= 91 && days <= 180) interestRate = 6.5;
                    else if (days > 180) interestRate = 7.0;
                }
            } else { 
                if (amount >= 1.0) {
                    if (days >= 7 && days <= 45) interestRate = 5.5;
                    else if (days >= 46 && days <= 90) interestRate = 6.0;
                    else if (days >= 91 && days <= 180) interestRate = 6.5;
                    else if (days > 180) interestRate = 7.0;
                } else {
                    if (days >= 7 && days <= 45) interestRate = 5.0;
                    else if (days >= 46 && days <= 90) interestRate = 5.5;
                    else if (days >= 91 && days <= 180) interestRate = 6.0;
                    else if (days > 180) interestRate = 6.5;
                }
            }
        }

        else if (accountType.equalsIgnoreCase("RD")) {
            if (ageCategory.equalsIgnoreCase("Senior Citizen")) {
                if (amount >= 1.0) {
                    if (days >= 6 && days <= 12) interestRate = 7.0;
                    else if (days > 12) interestRate = 7.5;
                } else {
                    if (days >= 6 && days <= 12) interestRate = 6.5;
                    else if (days > 12) interestRate = 7.0;
                }
            } else { // General category
                if (amount >= 1.0) {
                    if (days >= 6 && days <= 12) interestRate = 6.5;
                    else if (days > 12) interestRate = 7.0;
                } else {
                    if (days >= 6 && days <= 12) interestRate = 6.0;
                    else if (days > 12) interestRate = 6.5;
                }
            }
        } else {
            System.out.println("Invalid account type. Please enter FD or RD.");
            sc.close();
            return;
        }
        double interest = (amount * 10000000 * interestRate * days) / (365 * 100);

        // Output the result
        System.out.println("Calculated interest: ₹" + interest);
        System.out.println("Applicable interest rate: " + interestRate + "%");

        sc.close();
    }
}
